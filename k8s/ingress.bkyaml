apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: url-shortener-ingress
  annotations:
    kubernetes.io/ingress.class: alb
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}]'
    # Optional: Add health check paths per service if they differ
    alb.ingress.kubernetes.io/healthcheck-path: /health
    alb.ingress.kubernetes.io/success-codes: "200-299"
spec:
  rules:
  - http:
      paths:
      # 1. Main Dashboard & UI Creation Flow
      - path: /
        pathType: Prefix
        backend:
          service:
            name: python-service
            port:
              number: 5000
      - path: /create
        pathType: Prefix
        backend:
          service:
            name: python-service
            port:
              number: 5000
      - path: /api/stats
        pathType: Prefix
        backend:
          service:
            name: python-service
            port:
              number: 5000

      # 2. Metadata Enrichment (Node.js)
      - path: /api/metadata
        pathType: Prefix
        backend:
          service:
            name: node-service
            port:
              number: 3000

      # 3. Short URL Redirects (Go)
      - path: /r/
        pathType: Prefix
        backend:
          service:
            name: go-service
            port:
              number: 8000