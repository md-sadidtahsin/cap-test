name: CI/CD Pipeline - URL Shortener

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  DOCKERHUB_USERNAME: mdsadidtahsin
  EKS_CLUSTER_NAME: urlshortener-cluster
  AWS_REGION: ap-south-1

# ─────────────────────────────────────────────
# JOB 1: Detect which services changed
# ─────────────────────────────────────────────
jobs:
  detect-changes:
    name: Detect Changed Services
    runs-on: ubuntu-latest
    outputs:
      go-changed: ${{ steps.filter.outputs.go }}
      python-changed: ${{ steps.filter.outputs.python }}
      node-changed: ${{ steps.filter.outputs.node }}
    steps:
      - uses: actions/checkout@v4

      - name: Check changed paths
        uses: dorny/paths-filter@v3
        id: filter
        with:
          filters: |
            go:
              - 'go-service/**'
            python:
              - 'python-service/**'
            node:
              - 'node-service/**'

  # ─────────────────────────────────────────────
  # JOB 2: SonarCloud Code Analysis (all services)
  # ─────────────────────────────────────────────
  sonarcloud:
    name: SonarCloud Analysis
    runs-on: ubuntu-latest
    needs: detect-changes
    steps:
      - uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v4
        with:
          go-version: '1.24'

      - name: Run Go tests with coverage
        working-directory: go-service
        env:
          CGO_ENABLED: '0'
        run: |
          go test ./... -coverprofile=coverage.out

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Node dependencies
        working-directory: node-service
        run: npm ci

      - name: Run Node tests with coverage
        working-directory: node-service
        run: npm test

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install Python dependencies
        working-directory: python-service
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r requirements-dev.txt

      - name: Run Python tests with coverage
        working-directory: python-service
        run: |
          python -m pytest --cov=app --cov-report=xml:coverage/coverage.xml tests

      - name: SonarCloud Scan
        uses: SonarSource/sonarcloud-github-action@master
        with:
          args: >
            -Dproject.settings=sonar-project.properties
            -Dsonar.qualitygate.wait=true
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}

  # ─────────────────────────────────────────────
  # JOB 3: Build & Push Go Service
  # ─────────────────────────────────────────────
  build-go:
    name: Build & Push Go Service
    runs-on: ubuntu-latest
    needs: [detect-changes, sonarcloud]
    if: needs.detect-changes.outputs.go-changed == 'true' || github.event_name == 'workflow_dispatch'
    steps:
      - uses: actions/checkout@v4

      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build & Push Go Service
        uses: docker/build-push-action@v5
        with:
          context: ./go-service
          push: true
          tags: |
            mdsadidtahsin/go-service:latest
            mdsadidtahsin/go-service:${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # ─────────────────────────────────────────────
  # JOB 4: Build & Push Python Service
  # ─────────────────────────────────────────────
  build-python:
    name: Build & Push Python Service
    runs-on: ubuntu-latest
    needs: [detect-changes, sonarcloud]
    if: needs.detect-changes.outputs.python-changed == 'true' || github.event_name == 'workflow_dispatch'
    steps:
      - uses: actions/checkout@v4

      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build & Push Python Service
        uses: docker/build-push-action@v5
        with:
          context: ./python-service
          push: true
          tags: |
            mdsadidtahsin/python-service:latest
            mdsadidtahsin/python-service:${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # ─────────────────────────────────────────────
  # JOB 5: Build & Push Node.js Service
  # ─────────────────────────────────────────────
  build-node:
    name: Build & Push Node Service
    runs-on: ubuntu-latest
    needs: [detect-changes, sonarcloud]
    if: needs.detect-changes.outputs.node-changed == 'true' || github.event_name == 'workflow_dispatch'
    steps:
      - uses: actions/checkout@v4

      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build & Push Node Service
        uses: docker/build-push-action@v5
        with:
          context: ./node-service
          push: true
          tags: |
            mdsadidtahsin/node-service:latest
            mdsadidtahsin/node-service:${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

