apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: node-service-monitor
  namespace: urlshortener
  labels:
    release: monitoring
spec:
  selector:
    matchLabels:
      app: node-service
  endpoints:
  - port: http
    path: /metrics
    interval: 15s
  namespaceSelector:
    matchNames:
    - urlshortener